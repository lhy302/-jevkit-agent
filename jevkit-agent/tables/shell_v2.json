{
  "schema_version": "1.0",
  "table_id": "shell_v2",
  "target_language": "shell",
  "skeleton_ref": "common_skeleton_v1",
  "semantic_mappings": {
    "/semantic/function/define": "/shell/function/define",
    "/semantic/function/return": "/shell/function/return",
    "/semantic/control/branch/if": "/shell/control/if",
    "/semantic/control/loop/for": "/shell/control/for",
    "/semantic/control/loop/while": "/shell/control/while",
    "/semantic/io/output": "/shell/io/output"
  },
  "nodes": {
    "/shell/function/define": {
      "type": "leaf",
      "template": "{func_name}() {",
      "spec_template": "定义 {func_name}():",
      "slots": ["func_name"],
      "maps_from": ["/semantic/function/define"]
    },
    "/shell/function/return": {
      "type": "leaf",
      "template": "return {expr}",
      "spec_template": "返回 {expr}",
      "slots": ["expr"],
      "maps_from": ["/semantic/function/return"]
    },
    "/shell/control/if": {
      "type": "leaf",
      "template": "if [ {cond} ]; then",
      "spec_template": "如果 {cond}:",
      "slots": ["cond"],
      "maps_from": ["/semantic/control/branch/if"]
    },
    "/shell/control/for": {
      "type": "leaf",
      "template": "for {var} in {iter}; do",
      "spec_template": "对于 {var} 中的 {iter}:",
      "slots": ["var", "iter"],
      "maps_from": ["/semantic/control/loop/for"]
    },
    "/shell/control/while": {
      "type": "leaf",
      "template": "while [ {cond} ]; do",
      "spec_template": "当 {cond}:",
      "slots": ["cond"],
      "maps_from": ["/semantic/control/loop/while"]
    },
    "/shell/io/output": {
      "type": "leaf",
      "template": "echo \"{expr}\"",
      "spec_template": "输出({expr})",
      "slots": ["expr"],
      "maps_from": ["/semantic/io/output"]
    }
  }
}
